  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Ablauf\n[  ] Schutzausr\xFCstung: Anzug, Mundschutz, Handschuhe (0/3)\n[  ] \xDCbersichtsfoto vor jeder Ver\xE4nderung: mind. 2 Spuren in einem Bild\n[  ] Jede T\xFCr fotografieren, bevor sie bewegt wird (0/0)\n[  ] Spurenmarker neben jede Spur, auch neben den Leichnam (0/9)\n[  ] Detailfoto mit Marker (0/9)\n[  ] Blutprobe mit Tupfer nehmen\n[  ] Einzeln und richtig verpacken (0/6)\n[  ] In die Asservatenkiste legen, sie ist tragbar (0/6)\n[  ] UV-Spuren finden und fotografieren (0/4)\n\nPunkte: 100/100   kein Abzug   Handschuhe: keine"
