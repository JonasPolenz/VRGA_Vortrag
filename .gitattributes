# Normalise line endings. Unity writes its serialized files with LF, so keep them LF on every
# machine; otherwise Windows checkouts get CRLF and Unity rewrites them, causing noisy diffs.
* text=auto
*.cs text diff=csharp
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.preset text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.physicMaterial text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.blend binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
